{
  "name": "watson-sak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "ENVIRONMENT=local-backend react-router dev",
    "dev:leder": "ENVIRONMENT=local-mock BRUKERPROFIL=leder-øst react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "unused": "react-router typegen && knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "react-router typegen && concurrently -n test,lint,format,types,unused -c green,yellow,magenta,cyan,blue \"pnpm run test\" \"pnpm run lint\" \"pnpm run format\" \"tsc --noEmit\" \"knip\""
  },
  "dependencies": {
    "@conform-to/react": "^1.21.2",
    "@conform-to/zod": "^1.21.2",
    "@grafana/faro-react": "^2.13.0",
    "@navikt/aksel-icons": "^8.20.1",
    "@navikt/ds-css": "^8.20.1",
    "@navikt/ds-react": "^8.20.1",
    "@navikt/ds-tailwind": "^8.20.1",
    "@navikt/oasis": "^4.2.2",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/docx": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/juice": "^53.0.0",
    "@platejs/list-classic": "^53.0.0",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "isbot": "^5.2.2",
    "platejs": "^53.3.18",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "unleash-client": "^6.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "protobufjs": "8.0.2",
      "esbuild": "0.28.1",
      "shell-quote": "^1.11.0",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "qs": "^6.16.0",
      "morgan": "^1.12.1",
      "tinypool@2": "^2.1.2",
      "ip-address@10": "^10.7.1",
      "brace-expansion@5": "^5.0.12",
      "source-map-js": "^1.2.2",
      "smol-toml@1": "^1.9.0",
      "@platejs/core": "^53.3.11",
      "undici@6": "^6.28.1",
      "undici@8": "^8.10.2",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
