{
  "name": "watson-sak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "ENVIRONMENT=local-backend react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "unused": "react-router typegen && knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "concurrently -n test,lint,format,types,unused -c green,yellow,magenta,cyan,blue \"pnpm run test\" \"pnpm run lint\" \"pnpm run format\" \"pnpm run typecheck\" \"pnpm run unused\""
  },
  "dependencies": {
    "@conform-to/react": "^1.20.2",
    "@conform-to/zod": "^1.20.2",
    "@grafana/faro-react": "^2.9.0",
    "@navikt/aksel-icons": "^8.6.0",
    "@navikt/ds-css": "^8.6.0",
    "@navikt/ds-react": "^8.6.0",
    "@navikt/ds-tailwind": "^8.6.0",
    "@navikt/oasis": "^4.1.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/list-classic": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "isbot": "^5.2.1",
    "platejs": "^53.3.3",
    "postcss": "^8.5.25",
    "postcss-import": "^16.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "unleash-client": "^6.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "protobufjs": "8.0.2",
      "esbuild": "0.28.1",
      "shell-quote": "1.8.4"
    }
  }
}
